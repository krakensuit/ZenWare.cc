#include "resource.h"
#include <windows.h>
IDI_MAINICON ICON "icon.ico"
IDR_ZENWARE_DLL RCDATA "..\\ZenWare.DLL\\bin\\Release\\ZenWare.dll"
// Однофайловая раздача: External и логотип тоже вшиты в лоадер.
// Собери сначала ZenWare.DLL и ZenWare.External в Release (или всё решение целиком).
IDR_ZENWARE_EXTERNAL RCDATA "..\\ZenWare.External\\bin\\Release\\ZenWare.External.exe"
IDR_LOGO_PNG RCDATA "zenwareLOGO.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ZENWARE_VER_MAJOR,ZENWARE_VER_MINOR,0,0
 PRODUCTVERSION ZENWARE_VER_MAJOR,ZENWARE_VER_MINOR,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "ZenWare.cc Loader"
   VALUE "FileVersion", ZENWARE_VER_STR
   VALUE "ProductName", "ZenWare.cc"
   VALUE "ProductVersion", ZENWARE_VER_STR
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
