# SAFETY: never commit built binaries, game-side files or auto-downloaded updates.
# Repo is source-only. Local builds stay in dist/ and %TEMP%.
# dist/ is fully generated by Build-SingleFile.ps1 - nothing from it belongs in git.
dist/
ZenWare_*.exe
ZenWare*.cfg
ZenWare.offsets

