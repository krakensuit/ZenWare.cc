root = true

# Repo stores files byte-for-byte, no EOL conversion (see .gitattributes).
[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{cpp,h,hpp,c}]
indent_style = tab
tab_width = 4

[*.{ps1,bat}]
indent_style = tab
tab_width = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{sln,vcxproj,filters}]
indent_style = space
indent_size = 2
